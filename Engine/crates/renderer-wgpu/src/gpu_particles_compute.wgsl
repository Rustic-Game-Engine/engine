struct Particle { position_age:vec4<f32>, velocity_lifetime:vec4<f32>, size_rotation:vec4<f32>, color:vec4<f32> };
struct Birth { slot:vec4<u32>, particle:Particle };
struct Collider { inverse_transform:mat4x4<f32>, transform:mat4x4<f32>, dimensions_shape:vec4<f32>, properties:vec4<f32> };
struct Parameters {
 timing:vec4<f32>, acceleration:vec4<f32>, camera:vec4<f32>, flags:vec4<u32>, births:vec4<u32>, extra:vec4<u32>,
 transform:mat4x4<f32>, inverse_transform:mat4x4<f32>, view_projection:mat4x4<f32>,
 gradient_colors:array<vec4<f32>,16>,gradient_times:array<vec4<f32>,16>,size_keys:array<vec4<f32>,16>,opacity_keys:array<vec4<f32>,16>,
 colliders:array<Collider,16>
};
@group(0) @binding(0) var<uniform> p:Parameters;
@group(0) @binding(1) var<storage,read_write> particles:array<Particle>;
@group(0) @binding(2) var<storage,read> births:array<Birth>;
fn safe_normalize(v:vec3<f32>)->vec3<f32>{let d=dot(v,v);if d<1e-20{return vec3<f32>(0.);}return v*inverseSqrt(d);}
fn sphere_hit(a:vec3<f32>,b:vec3<f32>,radius:f32)->vec4<f32>{let d=b-a;let aa=dot(d,d);if aa<1e-12{return vec4<f32>(0.,0.,0.,2.);}let bb=dot(a,d);let cc=dot(a,a)-radius*radius;let disc=bb*bb-aa*cc;if disc<0.{return vec4<f32>(0.,0.,0.,2.);}let t=(-bb-sqrt(disc))/aa;if t<0.||t>1.{return vec4<f32>(0.,0.,0.,2.);}return vec4<f32>(safe_normalize(a+d*t),t);}
fn box_hit(a:vec3<f32>,b:vec3<f32>,half_size:vec3<f32>)->vec4<f32>{let d=b-a;var entering=0.;var leaving=1.;var normal=vec3<f32>(0.);for(var axis=0u;axis<3u;axis++){if abs(d[axis])<1e-8{if abs(a[axis])>half_size[axis]{return vec4<f32>(0.,0.,0.,2.);}continue;}let aa=(-half_size[axis]-a[axis])/d[axis];let bb=(half_size[axis]-a[axis])/d[axis];let near=min(aa,bb);if near>=entering{entering=near;normal=vec3<f32>(0.);normal[axis]=-sign(d[axis]);}leaving=min(leaving,max(aa,bb));if entering>leaving{return vec4<f32>(0.,0.,0.,2.);}}if dot(normal,normal)==0.{return vec4<f32>(0.,0.,0.,2.);}return vec4<f32>(normal,entering);}
fn cylinder_hit(a:vec3<f32>,b:vec3<f32>,radius:f32,height:f32)->vec4<f32>{let d=b-a;var best=vec4<f32>(0.,0.,0.,2.);let aa=dot(d.xz,d.xz);if aa>1e-12{let bb=dot(a.xz,d.xz);let cc=dot(a.xz,a.xz)-radius*radius;let disc=bb*bb-aa*cc;if disc>=0.{let t=(-bb-sqrt(disc))/aa;let hit=a+d*t;if t>=0.&&t<=1.&&abs(hit.y)<=height{best=vec4<f32>(safe_normalize(vec3<f32>(hit.x,0.,hit.z)),t);}}}if abs(d.y)>1e-12{for(var i=0u;i<2u;i++){let side=select(-1.,1.,i==1u);if d.y*side<0.{let t=(side*height-a.y)/d.y;let hit=a+d*t;if t>=0.&&t<=1.&&t<best.w&&dot(hit.xz,hit.xz)<=radius*radius{best=vec4<f32>(0.,side,0.,t);}}}}return best;}
fn collide(a:vec3<f32>,b:vec3<f32>,c:Collider)->vec4<f32>{let aa=(c.inverse_transform*vec4<f32>(a,1.)).xyz;let bb=(c.inverse_transform*vec4<f32>(b,1.)).xyz;let half_size=c.dimensions_shape.xyz*0.5;let shape=u32(c.dimensions_shape.w);if shape==1u{return sphere_hit(aa,bb,max(half_size.x,max(half_size.y,half_size.z)));}if shape==2u{if aa.y>=0.&&bb.y<=0.&&aa.y!=bb.y{let t=aa.y/(aa.y-bb.y);let hit=mix(aa,bb,t);if abs(hit.x)<=half_size.x&&abs(hit.z)<=half_size.z{return vec4<f32>(0.,1.,0.,t);}}return vec4<f32>(0.,0.,0.,2.);}if shape==3u{return cylinder_hit(aa,bb,max(half_size.x,half_size.z),half_size.y);}return box_hit(aa,bb,half_size);}
@compute @workgroup_size(64) fn spawn(@builtin(global_invocation_id) id:vec3<u32>){if id.x>=p.births.y{return;}let birth=births[p.births.x+id.x];if birth.slot.x<p.flags.x{particles[birth.slot.x]=birth.particle;}}
@compute @workgroup_size(64) fn simulate(@builtin(global_invocation_id) id:vec3<u32>){if id.x>=p.flags.x{return;}var particle=particles[id.x];if particle.velocity_lifetime.w<=0.||particle.position_age.w>=particle.velocity_lifetime.w{return;}let step=p.timing.x/f32(p.flags.y);var force=p.acceleration.xyz;if p.flags.z==1u{force=(p.inverse_transform*vec4<f32>(force,0.)).xyz;}for(var s=0u;s<p.flags.y;s++){particle.position_age.w+=step;if particle.position_age.w>=particle.velocity_lifetime.w{break;}if particle.size_rotation.z>0.5{continue;}var velocity=(particle.velocity_lifetime.xyz+force*step)*exp(-max(p.timing.y,0.)*step);let speed=length(velocity);if speed>max(p.timing.z,0.){velocity*=max(p.timing.z,0.)/max(speed,1e-20);}let old=particle.position_age.xyz;var next=old+velocity*step;particle.size_rotation.y+=p.timing.w*step;var start=old;var end=next;if p.flags.z==1u{start=(p.transform*vec4<f32>(old,1.)).xyz;end=(p.transform*vec4<f32>(next,1.)).xyz;}for(var c=0u;c<p.flags.w;c++){let volume=p.colliders[c];let contact=collide(start,end,volume);if contact.w<=1.{let normal=safe_normalize((transpose(volume.inverse_transform)*vec4<f32>(contact.xyz,0.)).xyz);let hit=mix(start,end,contact.w)+normal*0.001;next=hit;if p.flags.z==1u{next=(p.inverse_transform*vec4<f32>(hit,1.)).xyz;}if volume.properties.z>0.5{velocity=vec3<f32>(0.);particle.size_rotation.z=1.;}else{var world_velocity=velocity;if p.flags.z==1u{world_velocity=(p.transform*vec4<f32>(velocity,0.)).xyz;}let incoming=dot(world_velocity,normal);if incoming<0.{world_velocity=(world_velocity-normal*incoming)*(1.-clamp(volume.properties.y,0.,1.))-normal*incoming*clamp(volume.properties.x,0.,1.);}velocity=world_velocity;if p.flags.z==1u{velocity=(p.inverse_transform*vec4<f32>(world_velocity,0.)).xyz;}}break;}}particle.position_age=vec4<f32>(next,particle.position_age.w);particle.velocity_lifetime=vec4<f32>(velocity,particle.velocity_lifetime.w);}particles[id.x]=particle;}
