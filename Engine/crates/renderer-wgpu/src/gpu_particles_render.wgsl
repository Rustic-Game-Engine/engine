struct Particle { position_age:vec4<f32>, velocity_lifetime:vec4<f32>, size_rotation:vec4<f32>, color:vec4<f32> };
struct Birth { slot:vec4<u32>, particle:Particle };
struct Collider { inverse_transform:mat4x4<f32>, transform:mat4x4<f32>, dimensions_shape:vec4<f32>, properties:vec4<f32> };
struct Parameters {
 timing:vec4<f32>, acceleration:vec4<f32>, camera:vec4<f32>, flags:vec4<u32>, births:vec4<u32>, extra:vec4<u32>,
 transform:mat4x4<f32>, inverse_transform:mat4x4<f32>, view_projection:mat4x4<f32>,
 gradient_colors:array<vec4<f32>,16>,gradient_times:array<vec4<f32>,16>,size_keys:array<vec4<f32>,16>,opacity_keys:array<vec4<f32>,16>,
 colliders:array<Collider,16>
};
struct View { view_projection:mat4x4<f32>,camera:vec4<f32>,right:vec4<f32>,up:vec4<f32> };
@group(1) @binding(0) var<uniform> view:View;
@group(0) @binding(0) var<uniform> p:Parameters;
@group(0) @binding(1) var<storage,read> particles:array<Particle>;
struct Output{@builtin(position) position:vec4<f32>,@location(0) uv:vec2<f32>,@location(1) color:vec4<f32>};
fn linear_color(c:vec3<f32>)->vec3<f32>{return select(c/12.92,pow((c+vec3<f32>(0.055))/1.055,vec3<f32>(2.4)),c>vec3<f32>(0.04045));}
fn scalar_curve(t:f32,which:u32)->f32{var before=vec2<f32>(-1.,1.);var after=vec2<f32>(2.,1.);let count=select(p.births.w,p.extra.x,which==1u);for(var i=0u;i<count;i++){var key=p.size_keys[i].xy;if which==1u{key=p.opacity_keys[i].xy;}if key.x<=t&&key.x>before.x{before=key;}if key.x>=t&&key.x<after.x{after=key;}}if before.x<0.{return after.y;}if after.x>1.{return before.y;}if after.x<=before.x{return before.y;}return mix(before.y,after.y,(t-before.x)/(after.x-before.x));}
fn gradient(t:f32)->vec4<f32>{var before=-1.;var after=2.;var a=vec4<f32>(1.);var b=vec4<f32>(1.);for(var i=0u;i<p.births.z;i++){let time=p.gradient_times[i].x;if time<=t&&time>before{before=time;a=p.gradient_colors[i];}if time>=t&&time<after{after=time;b=p.gradient_colors[i];}}if before<0.{return b;}if after>1.{return a;}if after<=before{return a;}return mix(a,b,(t-before)/(after-before));}
@vertex fn vertex(@builtin(vertex_index) vertex:u32,@builtin(instance_index) instance:u32)->Output{var out:Output;out.position=vec4<f32>(2.,2.,2.,1.);out.uv=vec2<f32>(0.);out.color=vec4<f32>(0.);let particle=particles[instance];if particle.velocity_lifetime.w<=0.||particle.position_age.w>=particle.velocity_lifetime.w{return out;}let corners=array<vec2<f32>,6>(vec2<f32>(-1.,-1.),vec2<f32>(1.,-1.),vec2<f32>(1.,1.),vec2<f32>(-1.,-1.),vec2<f32>(1.,1.),vec2<f32>(-1.,1.));var position=particle.position_age.xyz;var velocity=particle.velocity_lifetime.xyz;if p.flags.z==1u{position=(p.transform*vec4<f32>(position,1.)).xyz;velocity=(p.transform*vec4<f32>(velocity,0.)).xyz;}let view_direction=normalize(view.camera.xyz-position+vec3<f32>(1e-10,0.,0.));var right=view.right.xyz;var up=view.up.xyz;let normalized=clamp(particle.position_age.w/particle.velocity_lifetime.w,0.,1.);let size=max(scalar_curve(normalized,0u),0.)*particle.size_rotation.x;let theta=particle.size_rotation.y;let xy=corners[vertex];let rotated=vec2<f32>(xy.x*cos(theta)-xy.y*sin(theta),xy.x*sin(theta)+xy.y*cos(theta));var horizontal=right*size;var vertical=up*size;let projected=velocity-view_direction*dot(velocity,view_direction);if p.camera.w>0.&&dot(projected,projected)>1e-10{up=normalize(projected);right=normalize(cross(up,view_direction));horizontal=right*size;vertical=up*(size+length(velocity)*p.camera.w);}out.position=view.view_projection*vec4<f32>(position+(horizontal*rotated.x+vertical*rotated.y)*0.5,1.);out.uv=xy*0.5+vec2<f32>(0.5);let color=gradient(normalized);out.color=vec4<f32>(linear_color(max(color.rgb,vec3<f32>(0.)))*max(p.acceleration.w,0.),color.a*clamp(scalar_curve(normalized,1u),0.,1.));return out;}
@fragment fn fragment(input:Output)->@location(0) vec4<f32>{let d=input.uv*2.-vec2<f32>(1.);let alpha=input.color.a*pow(max(1.-dot(d,d),0.),2.);if alpha<=0.{discard;}return vec4<f32>(input.color.rgb,alpha);}
@fragment fn multiply(input:Output)->@location(0) vec4<f32>{let d=input.uv*2.-vec2<f32>(1.);let alpha=input.color.a*pow(max(1.-dot(d,d),0.),2.);if alpha<=0.{discard;}return vec4<f32>(input.color.rgb*alpha,alpha);}
